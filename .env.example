# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local (ni ningún .env con valores reales) al repositorio.

# --- Autenticación (obligatoria) ---
# HMAC de las sesiones — debe ser el MISMO valor en middleware.ts y en las
# funciones /api (lib/auth-node.js). String largo y random, ej:
# openssl rand -base64 48
AUTH_SECRET=

# --- Cron de Vercel (opcional) ---
# Protege el endpoint del cron diario de alertas de Sitio Web
# (/api/negocio?recurso=alertas-sitio-web-notificar, ver vercel.json) --
# Vercel agrega automáticamente "Authorization: Bearer <este valor>" a las
# llamadas que hace su propio Cron cuando esta env var está configurada.
# String largo y random, ej: openssl rand -base64 32
CRON_SECRET=

# --- Buscador con IA (home de indexstore.cl) ---
# Clave compartida con el Worker de Cloudflare "indexstore-buscador-ia" (allá se
# llama ERP_LOG_KEY y debe tener EXACTAMENTE el mismo valor). Sin ella el ERP
# rechaza el registro de búsquedas (?recurso=buscador-ia-registrar).
# String largo y random, ej: openssl rand -base64 32
BUSCADOR_IA_KEY=

# --- Bsale ---
BSALE_ACCESS_TOKEN=
BSALE_OFFICE_ID=

# --- TUU (POS) ---
TUU_API_KEY=

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Base de datos (Vercel Postgres) ---
POSTGRES_URL=

# --- Correo general (todo el sistema EXCEPTO Indexpro) ---
# Opción A — SMTP directo:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Opción B — API HTTP de Brevo (recomendado si el SMTP directo del hosting
# no entrega bien a Gmail/Outlook, ver lib/mailer.js):
BREVO_API_KEY=

# --- Correo de Indexpro (solo el correo de presentación comercial) ---
SMTP_INDEXPRO_HOST=
SMTP_INDEXPRO_PORT=
SMTP_INDEXPRO_USER=
SMTP_INDEXPRO_PASS=
SMTP_INDEXPRO_FROM=

# --- Zoho Desk (eficiencia de tickets) ---
ZOHO_DC=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# --- WhatsApp Cloud API (módulo Clientes WhatsApp) ---
# Opcionales mientras no se conecte el webhook real de Meta — sin ellos el
# módulo funciona igual con datos demo (ver api/negocio.js, recurso
# whatsapp-demo-seed). El webhook público vive en
# /api/negocio?recurso=whatsapp-webhook (ver middleware.ts).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Token de acceso permanente (Usuario del sistema, Meta Business Settings)
# -- opcional, pero sin él el Análisis IA no puede descargar ni leer las
# fotos que mandan los clientes (ej. etiquetas de modelo del notebook),
# y tampoco se puede responder desde el ERP (ver WHATSAPP_PHONE_NUMBER_ID).
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID del número real conectado (WhatsApp Manager -> tu
# número -> "Identificador de número de teléfono"). Sin esta variable,
# "Responder desde el ERP" devuelve un error controlado.
WHATSAPP_PHONE_NUMBER_ID=

# --- Claude (Anthropic) -- Análisis IA de conversaciones de WhatsApp ---
# Sin esta variable, el botón "Analizar con IA" devuelve un error
# controlado; el resto del módulo funciona igual (ver api/negocio.js,
# recurso whatsapp-analizar).
ANTHROPIC_API_KEY=

# --- Correo de las casillas de vendedores (Cotizaciones -> correspondencia
# con el cliente) ---
# Cron diario (ver vercel.json -> cotizaciones-correos-sync) que revisa por
# IMAP la correspondencia real de correo con los clientes de Cotizaciones
# (cada vendedor manda las cotizaciones desde su propia casilla, no por la
# Cloud API de nadie). Sin estas variables, el cron corre igual pero cada
# casilla sin contraseña configurada queda marcada con error, sin tumbar
# las demás. Host/puerto son los mismos para las 4 casillas (mismo servidor
# de HostingPlus) -- el password de cada una es el de esa cuenta de correo
# en cPanel (Cuentas de correo -> Conectar dispositivos muestra host/puerto
# si alguna vez cambian).
EMAIL_IMAP_HOST=mail.indexstore.cl
EMAIL_IMAP_PORT=993
IMAP_PASS_SNUNEZ=
IMAP_PASS_DTORRES=
IMAP_PASS_NATHALIA=
IMAP_PASS_LUIGGI=
IMAP_PASS_VENTA=

# --- Mercado Público / Compra Ágil ---
# Opcional -- sin esta variable se usa el ticket demo público (el mismo que
# traía el portal compra-agil-two), que funciona pero tiene un límite de
# solicitudes más estricto. Se consigue uno propio y gratis en
# mercadopublico.cl > Desarrolladores.
MP_TICKET=
